{
  "name": "tracel",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/timeline",
    "apps/radar-worker",
    "packages/radar-contracts",
    "packages/radar-tracker"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tracel/web --",
    "build": "npm run build:web && npm run build:desktop && npm run build --workspace @tracel/radar-worker",
    "dev:web": "npm run dev --workspace @tracel/web --",
    "build:web": "npm run build --workspace @tracel/web",
    "deploy": "npm run deploy --workspace @tracel/web",
    "dev:desktop": "npm run tauri:dev --workspace @tracel/desktop --",
    "dev:desktop:ui": "npm run dev --workspace @tracel/desktop --",
    "build:desktop": "npm run build --workspace @tracel/desktop",
    "build:desktop:native": "npm run tauri:build --workspace @tracel/desktop",
    "build:desktop:installer": "npm run tauri:installer --workspace @tracel/desktop",
    "build:desktop:portable": "npm run build:desktop:native && powershell -NoProfile -File apps/desktop/scripts/package-portable.ps1",
    "package:desktop:portable": "powershell -NoProfile -File apps/desktop/scripts/package-portable.ps1 -PackageOnly",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "check:core": "cargo check --package tracel-agent --package tracel-core --package tracel-storage --package tracel-query",
    "test:core": "cargo test --package tracel-agent --package tracel-core --package tracel-storage --package tracel-query",
    "agent": "cargo run --package tracel-agent",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:rust && npm run test:rust",
    "icons:generate": "node apps/desktop/scripts/generate-icons.mjs",
    "dev:radar": "npm run dev --workspace @tracel/radar-worker"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2"
  }
}
