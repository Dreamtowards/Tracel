{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tracel-radar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "vars": { "APP_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000" },
  "triggers": { "crons": ["17 3 * * *"] },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3000, "period": 60 },
    },
  ],
}
